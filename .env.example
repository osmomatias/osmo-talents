# EXPLICANDO COMO PARA UMA CRIANÇA: este é o "molde do arquivo de segredos".
# O arquivo .env de verdade guarda as configurações e senhas do site (chave do Asaas,
# senha do e-mail...). Ele NUNCA vai para o GitHub nem para o ZIP de publicação,
# porque segredo não se espalha. Este .env.example é só o molde, sem segredo nenhum:
# mostra quais configurações existem e para que servem.
# Linhas que começam com # são comentários (o programa ignora). Para ligar uma
# configuração, tire o # da frente e preencha o valor.
# Copie este arquivo para .env e ajuste se precisar.
# Porta em que o app escuta (a mesma "App Port" configurada no CloudPanel)
PORT=3000
# Escuta só localmente; o nginx do CloudPanel faz a ponte com a internet
HOST=127.0.0.1
# Deixe true quando o site estiver com HTTPS (Let's Encrypt)
COOKIE_SECURE=true
# Onde fica o banco de dados (padrão: data/osmo_talents.sqlite)
# DB_PATH=/home/USUARIO/htdocs/osmo.com.br/data/osmo_talents.sqlite
# Backup do banco (npm run backup; na VPS roda sozinho toda noite). Padrões: pasta
# "backups" ao lado do banco, guardando as 14 cópias mais novas.
# BACKUP_DIR=/home/USUARIO/backups-osmo
# BACKUP_KEEP=14

# ---------- Pagamentos (Asaas) ----------
# Sem ASAAS_API_KEY os pagamentos ficam simulados.
# Sandbox (testes): https://api-sandbox.asaas.com/v3   Produção: https://api.asaas.com/v3
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# Frase longa e aleatória (32+ caracteres), usada para validar os avisos do Asaas
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_WEBHOOK_EMAIL=seu@email.com
# Frase longa e aleatória (24+ caracteres), usada para proteger dados guardados
# APP_SECRET=
# PUBLIC_URL=https://osmo.com.br
# Taxa da Osmo em % e dias até a liberação automática após a entrega
# FEE_PCT=10
# AUTO_RELEASE_DAYS=7

# ---------- Login social (opcional) ----------
# Cada botão só aparece quando o provedor está configurado. Retorno: https://SEU-DOMINIO/auth/<provedor>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- E-mail (recuperar senha) ----------
# Sem SMTP_HOST, o link "Esqueci minha senha" não aparece. Porta 465 = TLS direto; 587 = STARTTLS.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=465
# SMTP_USER=nao-responda@osmo.com.br
# SMTP_PASS=
# MAIL_FROM=Osmo Talents <nao-responda@osmo.com.br>
# Para testar no computador sem SMTP: MAIL_DEV=true mostra o e-mail no terminal
# MAIL_DEV=true

# ---------- Confirmar o celular no cadastro pelo WhatsApp (grátis, opcional) ----------
# "WhatsApp ao contrário": no cadastro, a PESSOA manda um código para o número da Osmo pelo
# WhatsApp e o servidor confirma o celular de quem mandou. Receber mensagens na API oficial
# do WhatsApp (WhatsApp Cloud API, da Meta) não tem custo. Sem as três primeiras chaves, o
# cadastro segue sem celular.
# Como ligar: developers.facebook.com > Criar app (tipo Empresa) > adicionar o produto WhatsApp.
#   - WHATSAPP_NUMBER: o número ligado à API, com DDI e DDD (só números);
#   - WHATSAPP_APP_SECRET: Configurações do app > Básico > Chave secreta do app;
#   - WHATSAPP_VERIFY_TOKEN: uma senha que você inventa; em WhatsApp > Configuração > Webhook,
#     use https://SEU-SITE/api/webhooks/whatsapp, esta mesma senha, e assine o campo "messages".
# WHATSAPP_NUMBER=5511912345678
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Opcional: com estas duas, a Osmo responde "Pronto, confirmado" no WhatsApp (também grátis,
# porque é resposta a quem escreveu primeiro). Use um token permanente (usuário do sistema).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# Para testar no computador sem a Meta: PHONE_DEV=true mostra o botão "Simular a mensagem"
# PHONE_DEV=true

# ---------- Top 10 de filmes e séries (TMDB, opcional) ----------
# A página /top10 mostra os 10 filmes e as 10 séries do momento, com dados do themoviedb.org.
# Chave grátis: themoviedb.org > Configurações > API > "API Read Access Token" (começa com eyJ).
# Sem a chave, a página /top10 avisa que ainda não está ligada.
# TMDB_TOKEN=

# ---------- Notificações no aparelho (Web Push, opcional) ----------
# Avisos no celular e no computador, os mesmos do e-mail (mensagens, propostas, etapas, anexos).
# Sem as duas chaves, o push fica desligado e o site funciona normalmente.
# Gere com: bash configurar-push.sh  (ou bash configurar-push.sh --local para testar no computador)
# Trocar as chaves depois faz todo mundo precisar ativar as notificações de novo.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contato para os correios de avisos (Google, Apple, Mozilla): mailto: ou https:
# VAPID_SUBJECT=mailto:contato@osmo.com.br

# ---------- Painel do dono (panorama da plataforma) ----------
# O único administrador do site (matias@osmo.com.br) está fixado em server.js.
# ADMIN_EMAILS não é mais lido: não há como dar acesso de admin pelo .env.

# ---------- Google Analytics (opcional) ----------
# Código de medição do GA4 (Administrador > Fluxos de dados > Web). Vazio = Analytics desligado.
# Mesmo configurado, o Analytics só carrega depois que a pessoa aceita o aviso de estatísticas (LGPD).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe Connect — integração local SOMENTE em testes; consulte docs/stripe.md.
# Selecionar Stripe também bloqueia a simulação de etapas sem pagamento.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_... (defina localmente, nunca no chat ou Git)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Pix permanece desligado até confirmar convite/elegibilidade na conta Stripe.
# STRIPE_PIX_ENABLED=false
