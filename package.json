{
  "name": "osmo-talents",
  "version": "3.1.0",
  "private": true,
  "description": "Osmo Talents: marketplace freelance pensado para pessoas neurodivergentes",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "publicar": "bash publicar.sh",
    "asaas:setup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/asaas-setup.js",
    "build:seo": "tsc -p tsconfig.seo.json",
    "build": "npm run build:seo && npm run build:router",
    "typecheck": "tsc -p tsconfig.seo.json --noEmit && tsc -p tsconfig.router-check.json",
    "pretest": "npm run build",
    "prestart": "node scripts/ensure-build.cjs",
    "predev": "node scripts/ensure-build.cjs",
    "preseed": "node scripts/ensure-build.cjs",
    "build:router": "tsc -p tsconfig.router.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
