{
  "name": "osmo-talents",
  "version": "3.1.0",
  "private": true,
  "description": "Osmo Talents: marketplace freelance pensado para pessoas neurodivergentes",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/dev.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/seed.js",
    "preseed": "node scripts/ensure-build.cjs",
    "asaas:check": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/asaas-check.js",
    "preasaas:check": "node scripts/ensure-build.cjs",
    "asaas:setup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/asaas-setup.js",
    "preasaas:setup": "node scripts/ensure-build.cjs",
    "laudo:conferir": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/conferir-laudo.js",
    "prelaudo:conferir": "node scripts/ensure-build.cjs",
    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/scripts/backup.js",
    "prebackup": "node scripts/ensure-build.cjs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:client": "tsc -p tsconfig.app.json && tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json",
    "build": "npm run build:node && npm run build:client && npm run build:library",
    "typecheck": "tsc -p tsconfig.node-check.json && tsc -p tsconfig.core-check.json && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.library.json --noEmit && tsc -p tsconfig.library-node.json --noEmit",
    "pretest": "npm run build",
    "test": "node --disable-warning=ExperimentalWarning --test dist/test/*.test.js",
    "prestart": "node scripts/ensure-build.cjs",
    "predev": "node scripts/ensure-build.cjs",
    "publicar": "bash publicar.sh",
    "prebuild": "node -e \"for (const dir of ['dist', 'biblioteca/dist']) require('node:fs').rmSync(dir, {recursive:true,force:true})\"",
    "build:library": "node dist/scripts/build-library.js",
    "biblioteca": "node biblioteca/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
