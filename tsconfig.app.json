{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleDetection": "legacy",
    "strict": true,
    "types": [],
    "rootDir": "client",
    "outDir": "public",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["client/app.ts", "client/app-types.d.ts", "client/globals.d.ts"]
}
